# NeoList Ortam Değişkenleri Şablonu
# Bu dosyayı ".env.local" olarak kopyalayın ve değerleri doldurun
# cp .env.example .env.local

# ═══════════════════════════════════════════════════════════════════════════════
# 🔴 ZORUNLU AYARLAR - Bunlar olmadan uygulama çalışmaz!
# ═══════════════════════════════════════════════════════════════════════════════

# Oracle Veritabanı Bağlantısı
# Format: host:port/service_name
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_CONNECTION_STRING=host:1521/service_name

# NextAuth.js Güvenlik Anahtarı
# Rastgele, güvenli bir değer olmalı (min 32 karakter)
# Oluşturmak için: openssl rand -base64 32
AUTH_SECRET=

# Uygulama URL'si
NEXTAUTH_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════════
# 🟡 OPSİYONEL AYARLAR - Ek özellikler için gerekli
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Telegram Bot Entegrasyonu
# ─────────────────────────────────────────────────────────────────────────────
# Bot oluşturmak için: Telegram'da @BotFather ile konuşun
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Webhook URL'si - Sunucu dışarıdan erişilebilir olmalı
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook

# ─────────────────────────────────────────────────────────────────────────────
# Zimbra Mail Entegrasyonu
# ─────────────────────────────────────────────────────────────────────────────
# Zimbra (setup later)
ZIMBRA_CALDAV_URL=https://mail.your-domain.com/dav/
ZIMBRA_ADMIN_EMAIL=admin@your-domain.com
ZIMBRA_ADMIN_PASSWORD=your_zimbra_admin_password

# ─────────────────────────────────────────────────────────────────────────────
# Bildirim E-posta (SMTP) - Zimbra veya Outlook
# ─────────────────────────────────────────────────────────────────────────────
# NOTIFY_MAIL_PROVIDER: zimbra | outlook | smtp
NOTIFY_MAIL_PROVIDER=zimbra

# Zimbra SMTP (NOTIFY_MAIL_PROVIDER=zimbra)
ZIMBRA_SMTP_HOST=mail.your-domain.com
ZIMBRA_SMTP_PORT=587
ZIMBRA_SMTP_SECURE=false
ZIMBRA_SMTP_USER=no-reply@your-domain.com
ZIMBRA_SMTP_PASS=your_smtp_password
ZIMBRA_SMTP_FROM=NeoList <no-reply@your-domain.com>

# Outlook SMTP (NOTIFY_MAIL_PROVIDER=outlook)
OUTLOOK_SMTP_HOST=smtp.office365.com
OUTLOOK_SMTP_PORT=587
OUTLOOK_SMTP_SECURE=false
OUTLOOK_SMTP_USER=
OUTLOOK_SMTP_PASS=
OUTLOOK_SMTP_FROM=NeoList <no-reply@yourcompany.com>

# Generic SMTP fallback (NOTIFY_MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# AI (Local Ollama)
# ─────────────────────────────────────────────────────────────────────────────
# Varsayılan hızlı model: qwen2.5:3b
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.3

# ═══════════════════════════════════════════════════════════════════════════════
# 🟢 GELİŞMİŞ AYARLAR - Varsayılanlar çoğu durumda uygundur
# ═══════════════════════════════════════════════════════════════════════════════

# Uygulama Modu: development | production | test
NODE_ENV=development

# Sunucu Portu
PORT=3000

# Debug Modu (true/false)
DEBUG=false
